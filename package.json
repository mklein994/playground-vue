{
  "name": "playground-vue",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently --kill-others --passthrough-arguments 'pnpm run build:tokens:watch' 'vite {@}' --",
    "build": "vite build",
    "build:all": "pnpm build:tokens && pnpm build:tailwind && vite build",
    "build:all-no-tailwind": "pnpm build:tokens && vite build",
    "build:tokens": "style-dictionary build --config ./sd.config.ts",
    "build:tokens:watch": "chokidar 'sd.config.ts' 'src/tokens/**/*.ts' --initial --command 'pnpm run build:tokens'",
    "build:tailwind": "tailwindcss --minify --input ./src/tailwind.css --output ./public/tailwind.min.css",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache --concurrency ${ESLINT_THREADS:-auto}",
    "lint:style": "stylelint 'src/**/*.{vue,css}'",
    "lint:ci": "eslint --cache --cache-strategy content --concurrency ${ESLINT_THREADS:-auto} --max-warnings 0 . && pnpm lint:style && prettier --check .",
    "format": "eslint --cache --concurrency ${ESLINT_THREADS:-auto} --fix --fix-type layout . && pnpm lint:style --fix && prettier --write .",
    "test": "vitest",
    "test:node": "node --test --test-reporter=spec",
    "test:run": "vitest run",
    "coverage": "vitest run --typecheck --isolate true --coverage"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "type": "module",
  "dependencies": {
    "@sentry/vue": "^10.69.0",
    "@sentry/wasm": "^10.69.0",
    "rrweb": "2.1.1",
    "temporal-polyfill": "^1.0.3",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "wavesurfer.js": "7.12.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "^10.0.1",
    "@heroicons/vue": "^2.2.0",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@observablehq/plot": "^0.6.17",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/typescript-plugin": "^3.3.9",
    "change-case": "^5.4.4",
    "chokidar-cli": "^3.0.0",
    "chroma-js": "^3.2.0",
    "concurrently": "^10.0.4",
    "d3": "^7.9.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-vue": "^10.10.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "highlight.js": "^11.11.1",
    "lightningcss": "^1.33.0",
    "modern-normalize": "^3.0.1",
    "pitchfinder": "^2.3.4",
    "pitchy": "^4.1.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "style-dictionary": "^5.5.1",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.9"
  }
}
