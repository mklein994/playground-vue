{
  "name": "playground-vue",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently --kill-others --passthrough-arguments 'pnpm run build:tokens:watch' 'vite {@}' --",
    "build": "vite build",
    "build:all": "pnpm build:tokens && pnpm build:tailwind && vite build",
    "build:all-no-tailwind": "pnpm build:tokens && vite build",
    "build:tokens": "style-dictionary build --config ./sd.config.ts",
    "build:tokens:watch": "chokidar 'sd.config.ts' 'src/tokens/**/*.ts' --initial --command 'pnpm run build:tokens'",
    "build:tailwind": "tailwindcss --minify --input ./src/tailwind.css --output ./public/tailwind.min.css",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache --concurrency ${ESLINT_THREADS:-auto}",
    "lint:style": "stylelint 'src/**/*.{vue,css}'",
    "lint:ci": "eslint --cache --cache-strategy content --concurrency ${ESLINT_THREADS:-auto} --max-warnings 0 . && pnpm lint:style && prettier --check .",
    "format": "eslint --cache --concurrency ${ESLINT_THREADS:-auto} --fix --fix-type layout . && pnpm lint:style --fix && prettier --write .",
    "test": "vitest",
    "test:node": "node --test --test-reporter=spec",
    "test:run": "vitest run",
    "coverage": "vitest run --typecheck --isolate true --coverage"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module",
  "dependencies": {
    "@sentry/vue": "^11.8.0",
    "@sentry/wasm": "^11.8.0",
    "rrweb": "2.1.7",
    "temporal-polyfill": "^1.0.6",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "wavesurfer.js": "8.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "^10.0.1",
    "@heroicons/vue": "^2.2.0",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@observablehq/plot": "^0.6.17",
    "@sentry/vite-plugin": "^11.8.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "^3.1.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/typescript-plugin": "^3.3.13",
    "change-case": "^5.4.4",
    "chokidar-cli": "^3.0.0",
    "chroma-js": "^3.2.0",
    "concurrently": "^10.0.6",
    "d3": "^7.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-vue": "^10.11.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "lightningcss": "^1.33.0",
    "modern-normalize": "^3.0.1",
    "pitchfinder": "^2.3.4",
    "pitchy": "^4.1.0",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.10",
    "sass": "^1.106.1",
    "style-dictionary": "^5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  }
}
